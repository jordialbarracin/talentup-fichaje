{
  "title": "TalentUP Fichaje - Overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Fichajes por dia (ultimos 7 dias)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM clock_ins WHERE created_at >= NOW() - INTERVAL '7 days'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Empleados activos",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM employees WHERE is_active = true",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Incidencias recientes",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "rawSql": "SELECT i.created_at, e.name as empleado, i.type, i.description FROM incidents i JOIN employees e ON i.employee_id = e.id ORDER BY i.created_at DESC LIMIT 20",
          "format": "table"
        }
      ]
    }
  ]
}